{
  "manifest_version": 3,
  "name": "Edgekin",
  "version": "0.3.1",
  "description": "Turn the visible edges of a web page into a tiny platform game.",
  "permissions": ["activeTab", "scripting"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "在当前网页打开 Edgekin"
  }
}
